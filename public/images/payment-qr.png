<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 320" width="320" height="320">
  <rect width="320" height="320" fill="#0c0e12" rx="12"/>
  <rect x="12" y="12" width="296" height="296" fill="none" stroke="#76552f" stroke-width="2" rx="8"/>
  
  <!-- Outer Finder 1 (Top Left) -->
  <rect x="36" y="36" width="64" height="64" fill="#c9a45c" rx="6"/>
  <rect x="44" y="44" width="48" height="48" fill="#0c0e12" rx="3"/>
  <rect x="52" y="52" width="32" height="32" fill="#c9a45c" rx="2"/>

  <!-- Outer Finder 2 (Top Right) -->
  <rect x="220" y="36" width="64" height="64" fill="#c9a45c" rx="6"/>
  <rect x="228" y="44" width="48" height="48" fill="#0c0e12" rx="3"/>
  <rect x="236" y="52" width="32" height="32" fill="#c9a45c" rx="2"/>

  <!-- Outer Finder 3 (Bottom Left) -->
  <rect x="36" y="220" width="64" height="64" fill="#c9a45c" rx="6"/>
  <rect x="44" y="228" width="48" height="48" fill="#0c0e12" rx="3"/>
  <rect x="52" y="236" width="32" height="32" fill="#c9a45c" rx="2"/>

  <!-- Timing Patterns -->
  <g fill="#e8d8b0">
    <rect x="108" y="40" width="10" height="10"/>
    <rect x="128" y="40" width="10" height="10"/>
    <rect x="148" y="40" width="10" height="10"/>
    <rect x="168" y="40" width="10" height="10"/>
    <rect x="188" y="40" width="10" height="10"/>
    <rect x="204" y="40" width="8" height="10"/>

    <rect x="40" y="108" width="10" height="10"/>
    <rect x="40" y="128" width="10" height="10"/>
    <rect x="40" y="148" width="10" height="10"/>
    <rect x="40" y="168" width="10" height="10"/>
    <rect x="40" y="188" width="10" height="10"/>
    <rect x="40" y="204" width="10" height="8"/>
  </g>

  <!-- Data Matrix Clusters -->
  <g fill="#c5b18a">
    <rect x="115" y="60" width="24" height="24"/>
    <rect x="150" y="65" width="30" height="15"/>
    <rect x="190" y="70" width="20" height="20"/>

    <rect x="60" y="115" width="24" height="24"/>
    <rect x="65" y="150" width="15" height="30"/>
    <rect x="70" y="190" width="20" height="20"/>

    <!-- Center Pattern -->
    <rect x="110" y="110" width="100" height="100" fill="#141a22" rx="6" stroke="#c9a45c" stroke-width="1.5"/>
    <circle cx="160" cy="160" r="32" fill="#0d1117" stroke="#76552f" stroke-width="1.5"/>
    <text x="160" y="166" font-family="'Segoe UI', sans-serif" font-weight="bold" font-size="15" fill="#c9a45c" text-anchor="middle" letter-spacing="1">UPI</text>

    <!-- Bottom Right Data -->
    <rect x="120" y="225" width="18" height="18"/>
    <rect x="145" y="225" width="18" height="28"/>
    <rect x="170" y="225" width="28" height="18"/>
    <rect x="205" y="225" width="18" height="18"/>
    <rect x="230" y="225" width="18" height="28"/>
    <rect x="255" y="225" width="28" height="18"/>

    <rect x="120" y="260" width="28" height="18"/>
    <rect x="155" y="260" width="18" height="18"/>
    <rect x="180" y="250" width="18" height="28"/>
    <rect x="205" y="260" width="28" height="18"/>
    <rect x="240" y="260" width="18" height="18"/>
    <rect x="265" y="250" width="18" height="28"/>

    <!-- Top Right Adjacent -->
    <rect x="225" y="115" width="20" height="20"/>
    <rect x="255" y="125" width="25" height="15"/>
    <rect x="235" y="150" width="15" height="25"/>
    <rect x="260" y="155" width="20" height="20"/>
    <rect x="225" y="185" width="25" height="15"/>
    <rect x="260" y="185" width="20" height="20"/>
  </g>

  <!-- Bottom Accent / UPI ID -->
  <text x="160" y="302" font-family="monospace" font-size="11" fill="#9a8866" text-anchor="middle" letter-spacing="1.5">artimas2026@upi</text>
</svg>
