# ──────────────────────────────────────────────
# ARTIMAS 26 Backend — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file.

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/artimas26

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# Cloudinary (Payment Screenshot Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ARTIMAS 26 <noreply@artimas.in>

# Allowed CORS Origins (comma-separated origins for production, e.g. https://artimas.in,https://www.artimas.in)
ALLOWED_ORIGINS=

# Frontend URL (for CORS fallback and email links)
CLIENT_URL=http://localhost:3000

# Admin Seed Credentials (used by npm run seed:admin)
ADMIN_EMAIL=admin@artimas.in
ADMIN_PASSWORD=
ADMIN_NAME=ARTIMAS Tech Team
